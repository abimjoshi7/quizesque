<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- dark studio bed: lit from the centre, falling off to near-black -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="74">
                <item android:offset="0" android:color="#FF242D34" />
                <item android:offset="0.42" android:color="#FF12181D" />
                <item android:offset="1" android:color="#FF04060A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- warm pool of light the gold sits in -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="55"
                android:gradientRadius="52">
                <item android:offset="0" android:color="#668A6220" />
                <item android:offset="0.55" android:color="#2A8A6220" />
                <item android:offset="1" android:color="#008A6220" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
